#!/usr/bin/env python3
"""Print one list-valued key from the project's config, one item per line.

The workflow has two steps that only the project knows the inputs to:

  regenerated_paths -- tracked output a git hook rewrites. Such a repository
    dirties them on `git worktree add` itself, so a task worktree is born
    dirty before an implementer runs a single command, and a controller that
    cannot tell a hook's output from unsaved work either destroys real work or
    reports every interrupted task as mid-edit.
  migration_homes -- the directories holding migration files. Numbers are a
    global singleton *per home*, so the same number in two homes is correct
    and the same number twice in one home is a defect git merges cleanly.

Neither can be guessed and neither belongs hardcoded in a skill, so both are
read from the project's own config through the same loader `lane` uses -- one
resolution of "which checkout am I configuring", not a second path to the same
file that can disagree with the first.

BOTH LIST KEYS ARE OPTIONAL, and absent means "this project has none": the key
is missing, or `null`, and this prints nothing and exits 0. That is
deliberately the same shape as a present-but-empty list, so a caller written as

    scripts/project-config regenerated_paths | xargs -r git checkout --

skips the step by doing nothing rather than by remembering to branch on it. A
step you can forget to skip is a step someone runs against the wrong project.

A list key holding something other than a list IS an error, not an empty
answer: a bare string would word-split at the caller into paths nobody wrote.

`--scalar` reads a single string instead, for the keys that name one thing
(`default_branch`, `required_check`, `worktree_dir`, `plan_dir`). **Absence is an
ERROR in this mode, not an empty answer**, and the asymmetry is deliberate: a
caller asking "which branch?" has no sensible way to proceed without a name, so
printing nothing would only move the failure to the caller, where it arrives as
an empty variable rather than a message. `default_branch` and `required_check`
are also in `REQUIRED_KEYS`, so for those two this fires only on a hand-edited
config. `worktree_dir` and `plan_dir` are NOT in `REQUIRED_KEYS` — for those two
this `--scalar` check is the only enforcement a missing key ever gets, so it
fires on any project that has simply never set one, not only a broken config.

`--flag` reads an optional boolean and answers THREE ways — `true`, `false`
or `unset` — because `false` and `unset` are different facts: `false` is a
project's decision, `unset` is no decision, and brainstorming's bounded path
warns only on the second. Absent and `null` both read `unset`. Unlike every
other mode, a checkout with NO config file answers `unset` rather than
failing: brainstorming runs in projects that never ran `init`, and a project
with no config has made no decision. A config that exists but cannot be read,
and a value that is not a JSON boolean, are errors — a flag that half-reads as
true is worse than one that refuses.

Usage: project-config [--scalar | --flag] KEY [CHECKOUT]
Exit:  0 ok (list mode: including "no such key") | 2 usage, unreadable config,
       wrong type, or a missing/empty scalar
"""

import sys
from pathlib import Path

# The loader lives at the plugin root, four levels up from this file
# (<plugin>/skills/wave-driven-development/scripts/). Resolved through the
# script's own path so an installation that symlinks the skill still finds it.
sys.path.insert(0, str(Path(__file__).resolve().parents[3] / "scripts"))

try:
    from lane_config import config_path, load_config
except ImportError:  # pragma: no cover - a broken install, not a code path
    sys.exit("project-config: cannot import lane_config — the plugin is incomplete")


def read_flag(key: str, checkout: str | None) -> int:
    """`--flag`: print `true`, `false` or `unset` for an optional boolean key."""
    try:
        if not config_path(checkout).exists():
            print("unset")
            return 0
        cfg = load_config(checkout)
    except (RuntimeError, ValueError, OSError) as exc:
        # ValueError is a config that will not parse as JSON; OSError is one
        # that exists but cannot be read (a directory, a permission). The loader
        # lets both through, and here both are the same answer: unreadable, not
        # "no decision".
        sys.stderr.write(f"{exc}\n")
        return 2

    value = cfg.get(key)
    if value is None:
        print("unset")
        return 0
    if not isinstance(value, bool):
        sys.stderr.write(
            f"project-config: {key} must be true or false in "
            f"{config_path(checkout)}, not a {type(value).__name__} ({value!r}) — "
            "a flag that half-reads as true is worse than one that refuses\n"
        )
        return 2
    print("true" if value else "false")
    return 0


def main(argv: list[str]) -> int:
    mode = argv[0] if argv and argv[0] in ("--scalar", "--flag") else None
    if mode:
        argv = argv[1:]
    if not 1 <= len(argv) <= 2:
        sys.stderr.write("usage: project-config [--scalar | --flag] KEY [CHECKOUT]\n")
        return 2

    key = argv[0]
    checkout = argv[1] if len(argv) == 2 else None

    if mode == "--flag":
        return read_flag(key, checkout)
    scalar = mode == "--scalar"

    try:
        cfg = load_config(checkout)
    except RuntimeError as exc:
        # The loader's messages already name the checkout it resolved and the
        # keys it wanted; repeating them here would only paraphrase.
        sys.stderr.write(f"{exc}\n")
        return 2

    value = cfg.get(key)

    if scalar:
        if not isinstance(value, str) or not value:
            # Name the config `load_config()` actually resolved for this checkout,
            # never the legacy `CONFIG_NAME` literal: a project correctly using
            # `.pitcall/config.json` was previously told its key "must be a
            # non-empty string in pitcall.config.json" — a file that must not
            # exist, and creating it on that advice trips the both-present error.
            sys.stderr.write(
                f"project-config: {key} must be a non-empty string in "
                f"{config_path(checkout)}, not {value!r} — this is a required key "
                "and the caller has no defensible default for it\n"
            )
            return 2
        print(value)
        return 0

    if value is None:
        return 0
    if not isinstance(value, list):
        sys.stderr.write(
            f"project-config: {key} must be a list, not {type(value).__name__} — "
            "a bare value word-splits at the caller into items nobody wrote\n"
        )
        return 2

    for item in value:
        if not isinstance(item, str):
            sys.stderr.write(f"project-config: {key} holds a non-string item: {item!r}\n")
            return 2
        # A path with a newline in it would arrive at the caller as two items.
        # Refuse rather than silently splitting one entry into two.
        if "\n" in item:
            sys.stderr.write(f"project-config: {key} item contains a newline: {item!r}\n")
            return 2
        print(item)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
